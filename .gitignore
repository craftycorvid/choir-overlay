build/
build-*/
*.o
*.so
.cache/
.venv/
compile_commands.json
.qt/

# Meson subprojects: keep the .wrap files, ignore extracted sources + downloads.
/subprojects/*/
/subprojects/packagecache/
/subprojects/packagefiles/
/subprojects/.wraplock

# makepkg build artifacts (packaging/PKGBUILD)
/packaging/pkg/
/packaging/src/
/packaging/*.pkg.tar.zst
/packaging/*.log

# AUR package (packaging/aur/PKGBUILD): keep PKGBUILD + .SRCINFO, ignore makepkg's
# build dirs, the $pkgname git clone, downloaded wrap sources, and built packages.
/packaging/aur/pkg/
/packaging/aur/src/
/packaging/aur/choir-overlay-git/
/packaging/aur/*.pkg.tar.zst
/packaging/aur/*.tar.gz
/packaging/aur/*.zip
/packaging/aur/*.log
